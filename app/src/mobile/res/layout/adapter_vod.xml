<?xml version="1.0" encoding="utf-8"?>
<!--
    「夜航」影片卡片：海报 + 底部渐变信息区。

    结构、层级、ID 与视图类型与改造前逐一对齐（ViewBinding 已开启，字段名与类型必须原样
    保留：image / delete / playback / site / progress / history_info / name / remark）。
    本次只改视觉属性：卡片圆角 14dp、信息区改为向上透明渐变、片名左对齐并加字重、
    集数行降级为次级前景色、进度条压到 3dp 并为海报下缘让出呼吸。
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:foreground="@drawable/shape_vod">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="?attr/colorSurfaceContainer"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/Vod.Grid" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@+id/image"
        android:layout_alignTop="@+id/image"
        android:layout_alignEnd="@+id/image"
        android:layout_alignBottom="@+id/history_info"
        android:background="@color/webhtv_color_player_scrim"
        android:scaleType="center"
        android:src="@drawable/ic_vod_delete"
        android:visibility="gone"
        app:shapeAppearanceOverlay="@style/Vod.Grid.Large"
        tools:visibility="visible" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/playback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@+id/image"
        android:layout_alignBottom="@+id/image"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/shape_vod_remark"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxWidth="110dp"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="11sp"
        tools:text="00:32 / 13:08" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/site"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@+id/image"
        android:layout_alignTop="@+id/image"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/shape_vod_site"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxWidth="92dp"
        android:singleLine="true"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:textSize="10sp"
        android:visibility="gone"
        tools:text="瓜子[优](DS)"
        tools:visibility="visible" />


    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/image"
        android:layout_alignStart="@+id/image"
        android:layout_alignEnd="@+id/image"
        android:background="?attr/colorSurfaceContainer"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="@color/transparent"
        app:trackStopIndicatorSize="0dp"
        app:trackThickness="3dp" />

    <!--
        信息区底是 shape_vod_name 的向上渐变（底部 90% 黑），压在壁纸上，与明暗调色板无关，
        因此标题与集数行都走恒定的 ?attr/webhtvColorOnWallpaper 家族：
        片名用 webhtvColorOnWallpaper，集数行用 webhtvColorOnWallpaperVariant（次级）。
        不要改成 ?attr/colorOnSurfaceVariant —— 浅色表会解析成深灰，压在海报上只有 1.4:1。
    -->
    <LinearLayout
        android:id="@+id/history_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/progress"
        android:layout_alignStart="@+id/image"
        android:layout_alignEnd="@+id/image"
        android:background="@drawable/shape_vod_name"
        android:gravity="start|center_vertical"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="14dp"
        android:paddingEnd="10dp"
        android:paddingBottom="9dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:gravity="start"
            android:includeFontPadding="false"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:textColor="?attr/webhtvColorOnWallpaper"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp"
            tools:text="云秀行" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/remark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="marquee"
            android:gravity="start"
            android:includeFontPadding="false"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:textColor="?attr/webhtvColorOnWallpaperVariant"
            android:textSize="11sp"
            tools:text="第01集. 海边散步" />

    </LinearLayout>

</RelativeLayout>
